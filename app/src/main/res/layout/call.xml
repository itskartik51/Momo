<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Header Row: Caller Name (Left) + Status/Chronometer (Right) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tv_caller_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="Kanu"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <!-- Shown while Ringing / Connecting -->
        <TextView
            android:id="@+id/tv_call_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="Ringing..."
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#4CAF50"
            android:visibility="visible" />

        <!-- Shown only after Peer Connects -->
        <Chronometer
            android:id="@+id/chrono_call_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#4CAF50"
            android:visibility="gone" />
    </RelativeLayout>

    <!-- Bottom Capsule Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:weightSum="3">

        <!-- 1. Mic Capsule -->
        <ImageView
            android:id="@+id/btn_capsule_mic"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_capsule_neutral"
            android:scaleType="centerInside"
            android:padding="7dp"
            android:contentDescription="Mic" />

        <!-- 2. Audio Route Capsule -->
        <ImageView
            android:id="@+id/btn_capsule_speaker"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_capsule_neutral"
            android:scaleType="centerInside"
            android:padding="7dp"
            android:contentDescription="Audio Route" />

        <!-- 3. End Call Capsule (Solid Red) -->
        <ImageView
            android:id="@+id/btn_capsule_end"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_capsule_red"
            android:scaleType="centerInside"
            android:padding="7dp"
            android:contentDescription="End Call" />
    </LinearLayout>
</LinearLayout>
