<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Subheader: MOMO -->
    <TextView
        android:id="@+id/tv_notification_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MOMO"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorSecondary"
        android:letterSpacing="0.08" />

    <!-- Header Row: Caller Name (Left) + Chronometer (Right) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp">

        <TextView
            android:id="@+id/tv_caller_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="Kanu"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary" />

        <Chronometer
            android:id="@+id/chrono_call_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#4CAF50" />
    </RelativeLayout>

    <!-- Capsule Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:weightSum="3">

        <!-- 1. Mic Capsule -->
        <ImageView
            android:id="@+id/btn_capsule_mic"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_capsule_neutral"
            android:scaleType="centerInside"
            android:padding="9dp"
            android:contentDescription="Mic" />

        <!-- 2. Audio Route Capsule -->
        <ImageView
            android:id="@+id/btn_capsule_speaker"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_capsule_neutral"
            android:scaleType="centerInside"
            android:padding="9dp"
            android:contentDescription="Audio Route" />

        <!-- 3. End Call Capsule (Solid Red) -->
        <ImageView
            android:id="@+id/btn_capsule_end"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_capsule_red"
            android:scaleType="centerInside"
            android:padding="9dp"
            android:contentDescription="End Call" />
    </LinearLayout>
</LinearLayout>
